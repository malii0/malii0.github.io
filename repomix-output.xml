<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Photography - Muhammed Ali Onurlucan</title>
    <meta
      name="description"
      content="Personal photo gallery by Muhammed Ali Onurlucan."
    />

    <link rel="canonical" href="https://malionurlucan.me/photography/" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <script>
      const storedTheme = localStorage.getItem("theme");
      const prefersLight = window.matchMedia(
        "(prefers-color-scheme: light)",
      ).matches;
      if (storedTheme === "light" || (!storedTheme && prefersLight)) {
        document.documentElement.classList.add("light-mode");
      }
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />

    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Newsreader:ital,wght@0,400;0,500;1,400&display=swap"
    />

    <link
      rel="preload"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
      as="style"
      onload="
        this.onload = null;
        this.rel = 'stylesheet';
      "
    />
    <noscript
      ><link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    /></noscript>

    <link rel="stylesheet" href="/style.css" fetchpriority="high" />
  </head>
  <body class="photography-page">
    <nav class="site-nav">
      <a href="/" class="brand">m.a.o</a>
      <div class="nav-items">
        <a href="/">home</a>
        <a href="/projects/">projects</a>
        <a href="/notes/">notes</a>
        <a href="/reading/">read / watch</a>
        <a href="/photography/" class="active">photography</a>
      </div>
    </nav>

    <main class="container container-single">
      <div class="page-label">photography</div>
      <p class="page-intro">Some photos I've taken, nothing more.</p>

      <!-- Dynamic Photo Grid Container -->
      <div id="photo-gallery" class="photo-grid"></div>
    </main>

    <!-- Accessible Lightbox Overlay -->
    <div
      id="lightbox"
      class="lightbox-overlay"
      role="dialog"
      aria-modal="true"
      aria-label="Image preview"
      tabindex="-1"
    >
      <div class="lightbox-header">
        <span
          class="lightbox-counter"
          id="lightbox-counter"
          aria-live="polite"
        ></span>
        <button
          type="button"
          class="lightbox-btn"
          id="lightbox-close"
          aria-label="Close dialog (Escape)"
        >
          &times;
        </button>
      </div>

      <button
        type="button"
        class="lightbox-btn lightbox-nav lightbox-prev"
        id="lightbox-prev"
        aria-label="Previous photo"
      >
        &#8249;
      </button>

      <div class="lightbox-stage" id="lightbox-stage">
        <div class="lightbox-img-wrapper">
          <img id="lightbox-img" class="lightbox-img" src="" alt="" />
        </div>
      </div>

      <button
        type="button"
        class="lightbox-btn lightbox-nav lightbox-next"
        id="lightbox-next"
        aria-label="Next photo"
      >
        &#8250;
      </button>

      <div class="lightbox-footer">
        <div class="lightbox-caption" id="lightbox-caption"></div>
      </div>
    </div>

    <!-- /utils.js inline script'ten ÖNCE çağrılır -->
    <script src="/utils.js"></script>
    <script>
      document.addEventListener("DOMContentLoaded", async function () {
        loadPageIntro("photography");

        const gallery = document.getElementById("photo-gallery");
        const lightbox = document.getElementById("lightbox");
        const lightboxImg = document.getElementById("lightbox-img");
        const lightboxCounter = document.getElementById("lightbox-counter");
        const lightboxCaption = document.getElementById("lightbox-caption");
        const lightboxCloseBtn = document.getElementById("lightbox-close");
        const lightboxPrevBtn = document.getElementById("lightbox-prev");
        const lightboxNextBtn = document.getElementById("lightbox-next");
        const lightboxStage = document.getElementById("lightbox-stage");

        let photoItems = [];
        let currentIndex = -1;
        let lastFocusedElement = null;
        let isLightboxOpen = false;

        function updateLightboxView() {
          if (currentIndex < 0 || currentIndex >= photoItems.length) return;
          const item = photoItems[currentIndex];
          const filename = item.filename;
          const fullResUrl = `/img/photos/${encodeURIComponent(filename)}`;
          const thumbUrl = `https://wsrv.nl/?url=malionurlucan.me/img/photos/${encodeURIComponent(filename)}&w=640&q=80&output=webp`;

          lightboxCounter.textContent = `${currentIndex + 1} / ${photoItems.length}`;
          lightboxCaption.textContent = item.location ? item.location : "";
          lightboxImg.alt = item.alt
            ? item.alt
            : `Photograph ${currentIndex + 1}`;

          // Show cached thumbnail immediately as placeholder, swap once full-res loads
          lightboxImg.classList.add("loading-placeholder");
          lightboxImg.src = thumbUrl;

          const fullImgLoader = new Image();
          fullImgLoader.src = fullResUrl;
          fullImgLoader.onload = function () {
            if (
              currentIndex >= 0 &&
              photoItems[currentIndex].filename === filename
            ) {
              lightboxImg.src = fullResUrl;
              lightboxImg.classList.remove("loading-placeholder");
            }
          };
          fullImgLoader.onerror = function () {
            lightboxImg.classList.remove("loading-placeholder");
          };
        }

        function openLightbox(index, triggerEl) {
          currentIndex = index;
          lastFocusedElement = triggerEl || document.activeElement;
          isLightboxOpen = true;

          updateLightboxView();
          lightbox.classList.add("active");
          document.body.classList.add("scroll-locked");

          // History push state for mobile back button closing
          history.pushState({ lightboxOpen: true }, "");

          lightboxCloseBtn.focus();
        }

        function closeLightbox(fromPopstate = false) {
          if (!isLightboxOpen) return;
          isLightboxOpen = false;

          lightbox.classList.remove("active");
          document.body.classList.remove("scroll-locked");
          lightboxImg.src = "";
          currentIndex = -1;

          if (!fromPopstate && history.state && history.state.lightboxOpen) {
            history.back();
          }

          if (
            lastFocusedElement &&
            typeof lastFocusedElement.focus === "function"
          ) {
            lastFocusedElement.focus();
          }
        }

        function showNext() {
          if (photoItems.length <= 1) return;
          currentIndex = (currentIndex + 1) % photoItems.length;
          updateLightboxView();
        }

        function showPrev() {
          if (photoItems.length <= 1) return;
          currentIndex =
            (currentIndex - 1 + photoItems.length) % photoItems.length;
          updateLightboxView();
        }

        // Lightbox Navigation Listeners
        lightboxCloseBtn.addEventListener("click", () => closeLightbox(false));
        lightboxNextBtn.addEventListener("click", showNext);
        lightboxPrevBtn.addEventListener("click", showPrev);

        // Backdrop click closing
        lightboxStage.addEventListener("click", function (e) {
          if (
            e.target === lightboxStage ||
            e.target.classList.contains("lightbox-img-wrapper")
          ) {
            closeLightbox(false);
          }
        });

        // Keyboard Controls & Focus Trap
        document.addEventListener("keydown", function (e) {
          if (!isLightboxOpen) return;

          if (e.key === "Escape") {
            e.preventDefault();
            closeLightbox(false);
          } else if (e.key === "ArrowRight") {
            e.preventDefault();
            showNext();
          } else if (e.key === "ArrowLeft") {
            e.preventDefault();
            showPrev();
          } else if (e.key === "Tab") {
            const focusables = [
              lightboxCloseBtn,
              lightboxPrevBtn,
              lightboxNextBtn,
            ].filter((btn) => btn.offsetParent !== null);
            if (focusables.length === 0) return;
            const first = focusables[0];
            const last = focusables[focusables.length - 1];

            if (e.shiftKey && document.activeElement === first) {
              e.preventDefault();
              last.focus();
            } else if (!e.shiftKey && document.activeElement === last) {
              e.preventDefault();
              first.focus();
            }
          }
        });

        // Touch Swipe Handling
        let touchStartX = 0;
        let touchStartY = 0;
        lightboxStage.addEventListener(
          "touchstart",
          function (e) {
            if (e.changedTouches.length === 1) {
              touchStartX = e.changedTouches[0].clientX;
              touchStartY = e.changedTouches[0].clientY;
            }
          },
          { passive: true },
        );

        lightboxStage.addEventListener(
          "touchend",
          function (e) {
            if (e.changedTouches.length === 1) {
              const diffX = e.changedTouches[0].clientX - touchStartX;
              const diffY = e.changedTouches[0].clientY - touchStartY;
              if (Math.abs(diffX) > 45 && Math.abs(diffX) > Math.abs(diffY)) {
                if (diffX < 0) {
                  showNext();
                } else {
                  showPrev();
                }
              }
            }
          },
          { passive: true },
        );

        // Popstate handler for mobile back button
        window.addEventListener("popstate", function (e) {
          if (isLightboxOpen) {
            closeLightbox(true);
          }
        });

        // Load Gallery
        try {
          const res = await fetch("/data/photos.json");
          if (!res.ok) throw new Error("fetch failed: " + res.status);
          const rawData = await res.json();

          if (!Array.isArray(rawData) || rawData.length === 0) {
            gallery.innerHTML =
              '<p class="empty-note">No photos published yet, check back soon.</p>';
            return;
          }

          photoItems = rawData
            .map(normalizePhotoEntry)
            .filter((p) => p.filename);

          gallery.innerHTML = "";
          photoItems.forEach((item, index) => {
            const filename = item.filename;
            const altText = item.alt ? item.alt : `Photograph ${index + 1}`;
            const fullResUrl = `/img/photos/${encodeURIComponent(filename)}`;
            const thumbUrl = `https://wsrv.nl/?url=malionurlucan.me/img/photos/${encodeURIComponent(filename)}&w=640&q=80&output=webp`;

            const card = document.createElement("div");
            card.className = "photo-card";

            const link = document.createElement("a");
            link.href = fullResUrl;
            link.setAttribute(
              "aria-label",
              item.location ? `${altText} - ${item.location}` : altText,
            );

            const imageElement = document.createElement("img");
            imageElement.src = thumbUrl;
            imageElement.alt = altText;
            imageElement.loading = "lazy";
            imageElement.decoding = "async";

            imageElement.onerror = function () {
              if (this.src !== fullResUrl) {
                this.src = fullResUrl;
              }
            };

            link.appendChild(imageElement);
            card.appendChild(link);

            if (item.location) {
              const caption = document.createElement("div");
              caption.className = "photo-caption";
              caption.textContent = item.location;
              card.appendChild(caption);
            }

            link.addEventListener("click", function (e) {
              if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0)
                return;
              e.preventDefault();
              openLightbox(index, link);
            });

            gallery.appendChild(card);
          });
        } catch (err) {
          console.error("Gallery failed to load:", err);
          gallery.innerHTML =
            '<p class="empty-note">Unable to load gallery at the moment.</p>';
        }
      });
    </script>

    <script src="/main.js"></script>
    <script
      data-goatcounter="https://malionurlucan.goatcounter.com/count"
      async
      src="//gc.zgo.at/count.js"
    ></script>
  </body>
</html>
