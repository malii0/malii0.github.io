/* style.css */

:root {
    --bg-color: #f3efe6;
    --bg-alt: #ece5d5;
    --text-color: #221f1a;
    --text-secondary: #6b6354;
    --text-muted: #8a8172;
    --heading-color: #1f1c17;
    --accent: #a13d2b;
    --border-color: #ddd3c0;
    --btn-bg: #ece5d5;
    --btn-hover: #e2d8c3;
}

body.light-mode, html.light-mode {
    --bg-color: #16130f;
    --bg-alt: #1e1a14;
    --text-color: #ece5d5;
    --text-secondary: #a89f8c;
    --text-muted: #776f5f;
    --heading-color: #f3efe6;
    --accent: #d97757;
    --border-color: #3a342a;
    --btn-bg: #241f18;
    --btn-hover: #2d271e;
}

* { box-sizing: border-box; margin: 0; padding: 0; }

html { scroll-behavior: smooth; }

:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 2px;
}

@media (prefers-reduced-motion: no-preference) {
    .theme-btn:hover { transform: scale(1.08); }
    .social-row a:hover { transform: translateY(-2px); }
}
@media (prefers-reduced-motion: reduce) {
    * { transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; }
}

body {
    background-color: var(--bg-color);
    color: var(--text-color);
    font-family: 'Newsreader', serif;
    font-size: 16px;
    line-height: 1.75;
    font-weight: 400;
    transition: background-color 0.3s, color 0.3s;
    -webkit-font-smoothing: antialiased;
}

.mono {
    font-family: 'JetBrains Mono', monospace;
}

/* --- TOP NAV --- */
.site-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 32px;
    border-bottom: 0.5px solid var(--border-color);
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    max-width: 780px;
    margin: 0 auto;
}

.site-nav .brand {
    color: var(--heading-color);
    font-weight: 700;
    text-decoration: none;
    letter-spacing: -0.2px;
}
.site-nav .brand:hover { text-decoration: none; color: var(--accent); }

.site-nav .nav-items {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
}

.site-nav .nav-items a {
    color: var(--text-secondary);
    text-decoration: none;
    padding-bottom: 3px;
    border-bottom: 1px solid transparent;
}
.site-nav .nav-items a:hover { color: var(--text-color); text-decoration: none; }
.site-nav .nav-items a.active {
    color: var(--accent);
    border-bottom: 1px solid var(--accent);
}

/* --- MAIN CONTAINER --- */
.container {
    width: 100%;
    max-width: 660px;
    padding: 56px 24px 70px;
    margin: 0 auto;
}

/* --- HOME: IDENTITY BLOCK --- */
.identity-block {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 28px;
}

.profile-pic {
    width: 88px;
    height: 88px;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid var(--border-color);
    flex-shrink: 0;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.08);
}

body.light-mode .profile-pic { box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.08); }

h1 {
    font-family: 'JetBrains Mono', monospace;
    font-size: 1.15rem;
    color: var(--heading-color);
    font-weight: 700;
    letter-spacing: -0.2px;
    margin-bottom: 4px;
    text-wrap: balance;
}

.tagline {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    color: var(--text-muted);
}

h2 {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-top: 40px;
    margin-bottom: 16px;
    font-weight: 500;
}

.about-text p { margin-top: 12px; color: var(--text-color); text-wrap: pretty; }
.about-text p:first-child { margin-top: 0; }
.about-text { max-width: 560px; }

.inline-link { color: var(--accent); text-decoration: underline; text-decoration-color: var(--border-color); text-underline-offset: 2px; }
.inline-link:hover { text-decoration-color: var(--accent); }

a { color: var(--accent); text-decoration: none; }
a:hover { text-decoration: underline; }

/* --- CV LINK --- */
.cv-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 0.78rem;
    color: var(--accent);
    text-decoration: none;
    margin-top: 22px;
    margin-bottom: 6px;
    padding: 7px 14px;
    border: 1px solid var(--accent);
    border-radius: 20px;
}
.cv-link:hover { background: var(--accent); color: var(--bg-color); text-decoration: none; }

/* --- SOCIAL / QUICK LINKS ROW --- */
.social-row {
    display: flex;
    gap: 20px;
    margin-top: 16px;
    flex-wrap: wrap;
