        <div class="page-label">photography</div>
        <p class="page-intro">Some photos I've taken, nothing more.</p>

        <!-- Dynamic Photo Grid Container -->
        <div id="photo-gallery" class="photo-grid"></div>

    </main>

    <script>
        document.addEventListener("DOMContentLoaded", async function() {
            const gallery = document.getElementById("photo-gallery");

            try {
                // Ordered by data/photos.json (managed via the panel) instead of
                // a live GitHub directory listing, so photo order is controllable.
                const res = await fetch("/data/photos.json", { cache: "no-store" });
                if (!res.ok) throw new Error("fetch failed: " + res.status);
                const filenames = await res.json();

                if (!Array.isArray(filenames) || filenames.length === 0) {
                    gallery.innerHTML = '<p class="empty-note">No photos published yet, check back soon.</p>';
                    return;
                }

                gallery.innerHTML = "";
                filenames.forEach((name, index) => {
                    const card = document.createElement("div");
                    card.className = "photo-card";
                    const fullResUrl = `/img/photos/${name}`;
                    // Serve a resized, compressed WebP preview via weserv.nl so the grid
                    // loads faster; natural aspect ratio is preserved (no cropping),
                    // and the full-resolution original still opens on click.
                    const thumbUrl = `https://wsrv.nl/?url=malionurlucan.me/img/photos/${encodeURIComponent(name)}&w=640&q=80&output=webp`;

                    const link = document.createElement("a");
                    link.href = fullResUrl;
                    link.target = "_blank";
                    link.rel = "noopener";

                    const imageElement = document.createElement("img");
                    imageElement.src = thumbUrl;
                    imageElement.alt = `Photo ${index + 1}`;
                    imageElement.loading = "lazy";
                    imageElement.decoding = "async";

                    link.appendChild(imageElement);
                    card.appendChild(link);
                    gallery.appendChild(card);
                });
            } catch (err) {
                console.error("Gallery failed to load:", err);
                gallery.innerHTML = '<p class="empty-note">Unable to load gallery at the moment.</p>';
            }
        });
    </script>

    <script src="/main.js"></script>
    <script data-goatcounter="https://malionurlucan.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
</body>
</html>
