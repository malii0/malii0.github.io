    <script>
        document.addEventListener("DOMContentLoaded", async function() {
            const gallery = document.getElementById("photo-gallery");
            const apiUrl = "https://api.github.com/repos/malii0/malii0.github.io/contents/img/photos";

            try {
                let files = [];
                const cachedData = sessionStorage.getItem("gallery_photos");

                if (cachedData) {
                    files = JSON.parse(cachedData);
                } else {
                    const res = await fetch(apiUrl);
                    if (!res.ok) throw new Error("GitHub API fetch failed");
                    files = await res.json();
                    sessionStorage.setItem("gallery_photos", JSON.stringify(files));
                }

                const photos = files
                    .filter(f => /\.(jpe?g|png|webp)$/i.test(f.name))
                    .sort((a, b) => a.name.localeCompare(b.name, undefined, { numeric: true }));

                if (photos.length === 0) {
                    gallery.innerHTML = '<p class="empty-note">No photos published yet — check back soon.</p>';
                    return;
                }

                photos.forEach((file, index) => {
                    const card = document.createElement("div");
                    card.className = "photo-card";

                    const link = document.createElement("a");
                    link.href = `/img/photos/${file.name}`;
                    link.target = "_blank";
                    link.rel = "noopener";

                    const imageElement = document.createElement("img");
                    imageElement.src = `/img/photos/${file.name}`;
                    imageElement.alt = `Photo ${index + 1}`;
                    imageElement.loading = "lazy";

                    link.appendChild(imageElement);
                    card.appendChild(link);
                    gallery.appendChild(card);
                });
            } catch (err) {
                console.error("Gallery failed to load:", err);
                gallery.innerHTML = '<p class="empty-note">Unable to load gallery at the moment.</p>';
            }
        });
    </script>

