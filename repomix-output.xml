        <label for="page-notes-intro">Notes Tagline</label>
        <textarea
          id="page-notes-intro"
          placeholder="Notes page description"
        ></textarea>

        <label for="page-projects-intro">Projects Tagline</label>
        <textarea
          id="page-projects-intro"
          placeholder="Projects page description"
        ></textarea>

        <label for="page-reading-intro">Read / Watch Tagline</label>
        <textarea
          id="page-reading-intro"
          placeholder="Reading page description"
        ></textarea>

        <label for="page-photography-intro">Photography Tagline</label>
        <textarea
          id="page-photography-intro"
          placeholder="Photography page description"
        ></textarea>

        <button
          type="button"
          class="btn"
          id="pages-save"
          style="margin-top: 20px"
        >
          Save page taglines
        </button>
        <div class="status-msg" id="pages-status"></div>
      </section>

      <!-- NOTES / PROJECTS / READING TABS (generic) -->
      <section class="tab-panel" id="tab-notes" data-type="notes"></section>
      <section
        class="tab-panel"
        id="tab-projects"
        data-type="projects"
      ></section>
      <section class="tab-panel" id="tab-reading" data-type="reading"></section>

      <!-- PHOTOS TAB -->
      <section class="tab-panel" id="tab-photos">
        <button type="button" class="btn secondary" id="photos-load">
          Load current photos
        </button>
        <p class="section-note">
          Add new photos, provide alt text & optional location, reorder with
          arrows, delete with x, then save.
        </p>

        <label for="photos-input">Add photos</label>
        <input
          type="file"
          id="photos-input"
          accept="image/jpeg,image/png,image/webp"
          multiple
        />
        <div class="status-msg" id="upload-status"></div>

        <div id="photos-list" style="margin-top: 16px"></div>

        <button
          type="button"
          class="btn"
          id="photos-save"
          style="margin-top: 16px"
        >
          Save order, alt text & locations
        </button>
        <div class="status-msg" id="photos-status"></div>
      </section>
    </main>

    <!-- /utils.js panoda inline script'ten önce çağrılır -->
    <script src="/utils.js"></script>
    <script>
      const WORKER_BASE = "https://photo-uploader.m-alionurlucan.workers.dev";

      function getSecret() {
        return document.getElementById("f-secret").value;
      }

      async function api(path, payload) {
        const res = await fetch(WORKER_BASE + path, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(
            Object.assign({}, payload, { secret: getSecret() }),
          ),
        });
        const data = await res.json();
        if (!res.ok || data.error)
          throw new Error(data.error || "Request failed");
        return data;
      }

      function showStatus(elId, msg, ok) {
        const el = document.getElementById(elId);
        el.className = "status-msg " + (ok ? "ok" : "err");
        el.textContent = msg;
      }

      function randomKey() {
        return Math.random().toString(36).slice(2, 10);
      }

      const savedSecret = sessionStorage.getItem("panel_secret");
      if (savedSecret) document.getElementById("f-secret").value = savedSecret;
      document
        .getElementById("f-secret")
        .addEventListener("input", function (e) {
          sessionStorage.setItem("panel_secret", e.target.value);
        });

      document
        .getElementById("btn-logout")
        .addEventListener("click", function () {
          sessionStorage.removeItem("panel_secret");
          localStorage.removeItem("panel_secret");
          document.getElementById("f-secret").value = "";
          alert("Logged out. Panel secret cleared.");
        });

      // ====== TABS ======
      const tabButtons = document.querySelectorAll(".tab-switch button");
      tabButtons.forEach(function (btn) {
        btn.addEventListener("click", function () {
          tabButtons.forEach(function (b) {
            b.classList.remove("active");
          });
          btn.classList.add("active");
          document.querySelectorAll(".tab-panel").forEach(function (p) {
            p.classList.remove("active");
          });
          document
            .getElementById("tab-" + btn.dataset.tab)
            .classList.add("active");
        });
      });

      // ====== HOME TAB ======
      const iconPresets = {
        Email: "fa-solid fa-envelope",
        GitHub: "fa-brands fa-github",
        LinkedIn: "fa-brands fa-linkedin",
        ORCID: "fa-brands fa-orcid",
        ResearchGate: "fa-brands fa-researchgate",
        "X (Twitter)": "fa-brands fa-x-twitter",
      };

      let socialsState = [];

      function renderSocials() {
        const container = document.getElementById("socials-list");
        container.innerHTML = socialsState
          .map(function (s) {
            const presetMatch = Object.keys(iconPresets).find(function (k) {
              return iconPresets[k] === s.icon;
            });
            const options = Object.keys(iconPresets)
              .map(function (k) {
                return (
                  '<option value="' +
                  k +
                  '" ' +
                  (presetMatch === k ? "selected" : "") +
                  ">" +
                  k +
                  "</option>"
                );
              })
              .join("");
            const isCustom = !presetMatch;
            return (
              "" +
              '<div class="card" data-key="' +
              s._key +
              '">' +
              '<select class="preset-select" data-field="preset">' +
              options +
              '<option value="__custom__" ' +
              (isCustom ? "selected" : "") +
              ">Custom</option>" +
              "</select>" +
              '<div class="custom-icon-field" style="display:' +
              (isCustom ? "block" : "none") +
              '">' +
              "<label>Font Awesome class</label>" +
              '<input type="text" data-field="icon" value="' +
              escapeHtml(s.icon) +
              '" placeholder="fa-brands fa-mastodon">' +
              "</div>" +
              "<label>Label</label>" +
              '<input type="text" data-field="label" value="' +
              escapeHtml(s.label) +
              '">' +
              "<label>URL</label>" +
              '<input type="text" data-field="url" value="' +
              escapeHtml(s.url) +
              '" placeholder="https://... or mailto:...">' +
              '<div class="card-toolbar">' +
              '<button type="button" class="icon-btn danger" data-action="remove-social">remove</button>' +
              "</div>" +
              "</div>"
            );
          })
          .join("");

        container.querySelectorAll(".card").forEach(function (card) {
          const key = card.dataset.key;
          const entry = socialsState.find(function (s) {
            return s._key === key;
          });

          card
            .querySelector('[data-field="preset"]')
            .addEventListener("change", function (e) {
              const val = e.target.value;
              const customField = card.querySelector(".custom-icon-field");
              if (val === "__custom__") {
                customField.style.display = "block";
              } else {
                customField.style.display = "none";
                entry.icon = iconPresets[val];
              }
            });
          const customInput = card.querySelector('[data-field="icon"]');
          if (customInput)
            customInput.addEventListener("input", function (e) {
              entry.icon = e.target.value;
            });

          card
            .querySelector('[data-field="label"]')
            .addEventListener("input", function (e) {
              entry.label = e.target.value;
            });
          card
            .querySelector('[data-field="url"]')
            .addEventListener("input", function (e) {
              entry.url = e.target.value;
            });

          card
            .querySelector('[data-action="remove-social"]')
            .addEventListener("click", function () {
              socialsState = socialsState.filter(function (s) {
                return s._key !== key;
              });
              renderSocials();
            });
        });
      }

      document
        .getElementById("add-social")
        .addEventListener("click", function () {
          socialsState.push({
            _key: randomKey(),
            icon: "fa-solid fa-link",
            label: "",
            url: "",
          });
          renderSocials();
        });

      document
        .getElementById("home-load")
        .addEventListener("click", async function () {
          try {
            const res = await api("/panel/get", { type: "home" });
            document.getElementById("home-tagline").value =
              res.data.tagline || "";
            document.getElementById("home-about").value = res.data.about || "";
            socialsState = (res.data.socials || []).map(function (s) {
              return Object.assign({}, s, { _key: randomKey() });
            });
            renderSocials();
            showStatus("home-status", "Loaded.", true);
          } catch (err) {
            showStatus("home-status", "Failed to load: " + err.message, false);
          }
        });

      document
        .getElementById("home-save")
        .addEventListener("click", async function () {
          for (const s of socialsState) {
            if (s.url && !isSafeUrl(s.url)) {
              showStatus(
                "home-status",
                "Geçersiz URL: " +
                  s.url +
                  " (Yalnızca http, https, mailto veya site-içi yollar geçerlidir)",
                false,
              );
              return;
            }
          }

          const data = {
            tagline: document.getElementById("home-tagline").value,
            about: document.getElementById("home-about").value,
            socials: socialsState.map(function (s) {
              const copy = Object.assign({}, s);
              delete copy._key;
              return copy;
            }),
          };
          try {
            await api("/panel/save", { type: "home", data: data });
            showStatus("home-status", "Saved.", true);
          } catch (err) {
            showStatus("home-status", "Failed to save: " + err.message, false);
          }
        });

      // ====== PAGES TAB ======
      document
        .getElementById("pages-load")
        .addEventListener("click", async function () {
          try {
            const res = await api("/panel/get", { type: "pages" });
            const data = res.data || {};
            document.getElementById("page-notes-intro").value =
              data.notes || "";
            document.getElementById("page-projects-intro").value =
              data.projects || "";
            document.getElementById("page-reading-intro").value =
              data.reading || "";
            document.getElementById("page-photography-intro").value =
              data.photography || "";
            showStatus("pages-status", "Page taglines loaded.", true);
          } catch (err) {
            showStatus("pages-status", "Failed to load: " + err.message, false);
          }
        });

      document
        .getElementById("pages-save")
        .addEventListener("click", async function () {
          const payload = {
            notes: document.getElementById("page-notes-intro").value.trim(),
            projects: document
              .getElementById("page-projects-intro")
              .value.trim(),
            reading: document.getElementById("page-reading-intro").value.trim(),
            photography: document
              .getElementById("page-photography-intro")
              .value.trim(),
          };
          try {
            await api("/panel/save", { type: "pages", data: payload });
            showStatus("pages-status", "Page taglines saved.", true);
          } catch (err) {
            showStatus("pages-status", "Failed to save: " + err.message, false);
          }
        });

      // ====== NOTES / PROJECTS / READING TABS ======
      const entryTypeConfig = {
        notes: {
          label: "note",
          hasBadge: true,
          metaPlaceholder: "e.g. adaptive optics",
        },
        projects: {
          label: "project",
          hasBadge: false,
          metaPlaceholder: "e.g. web app, Next.js/Supabase",
        },
        reading: {
          label: "entry",
          hasBadge: false,
          metaPlaceholder: "e.g. paper, Author (2026)",
        },
      };
      const entryState = { notes: null, projects: null, reading: null };

      function buildEntryTabHtml() {
        return (
          "" +
          '<button type="button" class="btn secondary" data-action="load">Load current entries</button>' +
          '<button type="button" class="icon-btn" data-action="add" style="margin-bottom: 12px;">+ add new</button>' +
          '<div class="entry-cards"></div>' +
          '<button type="button" class="btn" data-action="save" style="margin-top: 10px;">Save changes</button>' +
          '<div class="status-msg" data-status></div>'
        );
      }

      function renderEntries(type) {
        const cfg = entryTypeConfig[type];
        const section = document.getElementById("tab-" + type);
        const container = section.querySelector(".entry-cards");
        const entries = entryState[type] || [];

        container.innerHTML =
          entries
            .map(function (e, i) {
              let badgeHtml = "";
              if (cfg.hasBadge) {
                badgeHtml =
                  "" +
                  "<label>Badge (optional)</label>" +
                  '<input type="text" data-field="badge" value="' +
                  escapeHtml(e.badge) +
                  '" placeholder="e.g. TR, PDF">';
              }
              return (
                "" +
                '<div class="card" data-key="' +
                e._key +
                '">' +
                "<label>Title</label>" +
                '<input type="text" data-field="title" value="' +
                escapeHtml(e.title) +
                '">' +
                "<label>Link (optional)</label>" +
                '<input type="text" data-field="url" value="' +
                escapeHtml(e.url) +
                '" placeholder="https://...">' +
                "<label>Meta line</label>" +
                '<input type="text" data-field="meta" value="' +
                escapeHtml(e.meta) +
                '" placeholder="' +
                cfg.metaPlaceholder +
                '">' +
                badgeHtml +
                "<label>Description</label>" +
                '<textarea data-field="desc">' +
                escapeHtml(e.desc) +
                "</textarea>" +
                '<div class="card-toolbar">' +
                '<button type="button" class="icon-btn" data-action="up" ' +
                (i === 0 ? "disabled" : "") +
                ">up</button>" +
                '<button type="button" class="icon-btn" data-action="down" ' +
                (i === entries.length - 1 ? "disabled" : "") +
                ">down</button>" +
                '<button type="button" class="icon-btn danger" data-action="delete">delete</button>' +
                "</div>" +
                "</div>"
              );
            })
            .join("") ||
          '<p class="section-note">Nothing loaded yet, click "Load current entries".</p>';

        container.querySelectorAll(".card").forEach(function (card) {
          const key = card.dataset.key;
          card.querySelectorAll("[data-field]").forEach(function (input) {
            input.addEventListener("input", function () {
              const entry = entryState[type].find(function (e) {
                return e._key === key;
              });
              entry[input.dataset.field] = input.value;
            });
          });
          const upBtn = card.querySelector('[data-action="up"]');
          if (upBtn)
            upBtn.addEventListener("click", function () {
              const idx = entryState[type].findIndex(function (e) {
                return e._key === key;
              });
              if (idx > 0) {
                const tmp = entryState[type][idx - 1];
                entryState[type][idx - 1] = entryState[type][idx];
                entryState[type][idx] = tmp;
                renderEntries(type);
              }
            });
          const downBtn = card.querySelector('[data-action="down"]');
          if (downBtn)
            downBtn.addEventListener("click", function () {
              const idx = entryState[type].findIndex(function (e) {
                return e._key === key;
              });
              if (idx < entryState[type].length - 1) {
                const tmp = entryState[type][idx + 1];
                entryState[type][idx + 1] = entryState[type][idx];
                entryState[type][idx] = tmp;
                renderEntries(type);
              }
            });
          card
            .querySelector('[data-action="delete"]')
            .addEventListener("click", function () {
              if (!confirm("Delete this entry?")) return;
              entryState[type] = entryState[type].filter(function (e) {
                return e._key !== key;
              });
              renderEntries(type);
            });
        });
      }

      Object.keys(entryTypeConfig).forEach(function (type) {
        const section = document.getElementById("tab-" + type);
        section.innerHTML = buildEntryTabHtml();
        const statusEl = section.querySelector("[data-status]");
        statusEl.id = type + "-status";

        section
          .querySelector('[data-action="load"]')
          .addEventListener("click", async function () {
            try {
              const res = await api("/panel/get", { type: type });
              entryState[type] = (res.data || []).map(function (e) {
                return Object.assign({}, e, { _key: randomKey() });
              });
              renderEntries(type);
              showStatus(type + "-status", "Loaded.", true);
            } catch (err) {
              showStatus(
                type + "-status",
                "Failed to load: " + err.message,
                false,
              );
            }
          });

        section
          .querySelector('[data-action="add"]')
          .addEventListener("click", function () {
            if (!entryState[type]) entryState[type] = [];
            entryState[type].unshift({
              _key: randomKey(),
              title: "",
              url: "",
              meta: "",
              desc: "",
              badge: "",
            });
            renderEntries(type);
          });

        section
          .querySelector('[data-action="save"]')
          .addEventListener("click", async function () {
            const currentEntries = entryState[type] || [];
            for (const e of currentEntries) {
              if (e.url && !isSafeUrl(e.url)) {
                showStatus(
                  type + "-status",
                  "Geçersiz URL: " +
                    e.url +
                    " (Yalnızca http, https, mailto veya site-içi yollar geçerlidir)",
                  false,
                );
                return;
              }
            }

            const entries = currentEntries
              .filter(function (e) {
                return e.title && e.title.trim();
              })
              .map(function (e) {
                const copy = Object.assign({}, e);
                delete copy._key;
                return copy;
              });
            try {
              await api("/panel/save", { type: type, data: entries });
              showStatus(type + "-status", "Saved.", true);
            } catch (err) {
              showStatus(
                type + "-status",
                "Failed to save: " + err.message,
                false,
              );
            }
          });
      });

      // ====== PHOTOS TAB ======
      let photosState = [];

      function renderPhotos() {
        const container = document.getElementById("photos-list");
        container.innerHTML =
          photosState
            .map(function (p, i) {
              const thumb =
                "https://wsrv.nl/?url=malionurlucan.me/img/photos/" +
                encodeURIComponent(p.filename) +
                "&w=120&q=70&output=webp";
              return (
                "" +
                '<div class="card photo-row" data-key="' +
                p._key +
                '">' +
                '<img src="' +
                thumb +
                '" alt="' +
                escapeHtml(p.alt || "") +
                '" onerror="this.src=\'/img/photos/' +
                encodeURIComponent(p.filename) +
                "'\">" +
                '<div class="photo-details">' +
                '<span class="fname">' +
                escapeHtml(p.filename) +
                "</span>" +
                '<input type="text" data-field="alt" value="' +
                escapeHtml(p.alt || "") +
                '" placeholder="Alt description (accessibility)">' +
                '<input type="text" data-field="location" value="' +
                escapeHtml(p.location || "") +
                '" placeholder="Location (e.g. Erzurum/Türkiye)">' +
                "</div>" +
                '<button type="button" class="icon-btn" data-action="up" ' +
                (i === 0 ? "disabled" : "") +
                ">up</button>" +
                '<button type="button" class="icon-btn" data-action="down" ' +
                (i === photosState.length - 1 ? "disabled" : "") +
                ">down</button>" +
                '<button type="button" class="icon-btn danger" data-action="delete">x</button>' +
                "</div>"
              );
            })
            .join("") ||
          '<p class="section-note">No photos loaded, click "Load current photos".</p>';

        container.querySelectorAll(".card").forEach(function (card) {
          const key = card.dataset.key;
          const altInput = card.querySelector('[data-field="alt"]');
          if (altInput) {
            altInput.addEventListener("input", function (e) {
              const target = photosState.find(function (p) {
                return p._key === key;
              });
              if (target) target.alt = e.target.value;
            });
          }

          const locInput = card.querySelector('[data-field="location"]');
          if (locInput) {
            locInput.addEventListener("input", function (e) {
              const target = photosState.find(function (p) {
                return p._key === key;
              });
              if (target) target.location = e.target.value;
            });
          }

          card
            .querySelector('[data-action="up"]')
            .addEventListener("click", function () {
              const idx = photosState.findIndex(function (p) {
                return p._key === key;
              });
              if (idx > 0) {
                const tmp = photosState[idx - 1];
                photosState[idx - 1] = photosState[idx];
                photosState[idx] = tmp;
                renderPhotos();
              }
            });

          card
            .querySelector('[data-action="down"]')
            .addEventListener("click", function () {
              const idx = photosState.findIndex(function (p) {
                return p._key === key;
              });
              if (idx < photosState.length - 1) {
                const tmp = photosState[idx + 1];
                photosState[idx + 1] = photosState[idx];
                photosState[idx] = tmp;
                renderPhotos();
              }
            });

          card
            .querySelector('[data-action="delete"]')
            .addEventListener("click", async function () {
              if (!confirm("Delete this photo from the site entirely?")) return;
              const target = photosState.find(function (p) {
                return p._key === key;
              });
              if (!target) return;

              const newPhotosState = photosState.filter(function (p) {
                return p._key !== key;
              });
              const payload = newPhotosState.map(function (p) {
                return {
                  filename: p.filename,
                  alt: p.alt || "",
                  location: p.location || "",
                };
              });

              try {
                await api("/panel/save", { type: "photos", data: payload });
                photosState = newPhotosState;
                renderPhotos();
              } catch (err) {
                showStatus(
                  "photos-status",
                  "Fotoğraf listesi güncellenemedi: " + err.message,
                  false,
                );
                return;
              }

              try {
                await api("/panel/delete-photo", { filename: target.filename });
                showStatus("photos-status", "Photo deleted completely.", true);
              } catch (err) {
                showStatus(
                  "photos-status",
                  "Sıra listeden kaldırıldı ama dosya silinemedi, worker.js loglarını kontrol et: " +
                    err.message,
                  false,
                );
              }
            });
        });
      }

      document
        .getElementById("photos-load")
        .addEventListener("click", async function () {
          try {
            const res = await api("/panel/get", { type: "photos" });
            const rawList = res.data || [];
            photosState = rawList.map(function (item) {
              const norm = normalizePhotoEntry(item);
              return {
                _key: randomKey(),
                filename: norm.filename,
                alt: norm.alt,
                location: norm.location,
              };
            });
            renderPhotos();
            showStatus("photos-status", "Loaded.", true);
          } catch (err) {
            showStatus(
              "photos-status",
              "Failed to load: " + err.message,
              false,
            );
          }
        });

      document
        .getElementById("photos-save")
        .addEventListener("click", async function () {
          try {
            const payload = photosState.map(function (p) {
              return {
                filename: p.filename,
                alt: p.alt || "",
                location: p.location || "",
              };
            });
            await api("/panel/save", { type: "photos", data: payload });
            showStatus(
              "photos-status",
              "Order, alt text & locations saved.",
              true,
            );
          } catch (err) {
            showStatus(
              "photos-status",
              "Failed to save: " + err.message,
              false,
            );
          }
        });

      function fileToBase64(file) {
        return new Promise(function (resolve, reject) {
          const reader = new FileReader();
          reader.onload = function () {
            resolve(reader.result.split(",")[1]);
          };
          reader.onerror = reject;
          reader.readAsDataURL(file);
        });
      }

      document
        .getElementById("photos-input")
        .addEventListener("change", async function (e) {
          const files = Array.from(e.target.files);
          if (files.length === 0) return;

          const uploadStatus = document.getElementById("upload-status");
          uploadStatus.className = "status-msg ok";
          uploadStatus.style.display = "block";

          let uploaded = 0;
          for (let i = 0; i < files.length; i++) {
            const file = files[i];
            let ext = (file.name.split(".").pop() || "jpg").toLowerCase();
            if (ext === "jpeg") ext = "jpg";
            const safeExt =
              ["jpg", "png", "webp"].indexOf(ext) !== -1 ? ext : "jpg";
            const filename = "photo_" + Date.now() + "_" + i + "." + safeExt;

            uploadStatus.textContent =
              "Uploading " + (i + 1) + "/" + files.length + "...";
            try {
              const base64 = await fileToBase64(file);
              await api("/panel/upload-photo", {
                filename: filename,
                base64: base64,
              });

              photosState.push({
                _key: randomKey(),
                filename: filename,
                alt: "",
                location: "",
              });
              const payload = photosState.map(function (p) {
                return {
                  filename: p.filename,
                  alt: p.alt || "",
                  location: p.location || "",
                };
              });
              await api("/panel/save", { type: "photos", data: payload });

              uploaded++;
              renderPhotos();
            } catch (err) {
              uploadStatus.className = "status-msg err";
              uploadStatus.textContent =
                "Failed on " +
                file.name +
                ": " +
                err.message +
                " (" +
                uploaded +
                " uploaded & saved)";
              renderPhotos();
              return;
            }
          }

          uploadStatus.className = "status-msg ok";
          uploadStatus.textContent =
            "Successfully uploaded " + uploaded + " photo(s) and saved.";
          e.target.value = "";
          renderPhotos();
        });
    </script>

    <script src="/main.js"></script>
  </body>
</html>
